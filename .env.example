# BharatVaani Live - Environment Variables
# Copy this file to .env and fill in your values

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Generate a stable high-entropy value for deployed instances. Never commit it.
ROOM_TOKEN_SECRET=

# Provider selection: "mock" for development, "gnani" for production
STT_PROVIDER=mock
TTS_PROVIDER=mock
TRANSLATION_PROVIDER=mock

# Gnani Prisma v2.5 (STT): select STT_PROVIDER=gnani and set this key.
# The key is sent as X-API-Key-ID from the backend only.
GNANI_API_KEY_ID=
PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3

# Gnani Timbre v2.5 (TTS): requires the same Gnani key as Prisma.
TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_HINDI_VOICE=Nalini
TIMBRE_TELUGU_VOICE=Suhana

# Translation API - leave empty for mock mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database
DATABASE_URL=sqlite:///./bharatvaani.db

# Room settings
ROOM_EXPIRY_MINUTES=120
